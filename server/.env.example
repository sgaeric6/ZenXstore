# Server environment variables (example)
# Copy this to server/.env when running locally. DO NOT commit real secrets.

DATABASE_URL=postgresql://user:password@localhost:5432/zenxstore
PAYSTACK_SECRET=sk_test_xxx_replace
PAYSTACK_PUBLIC=pk_test_xxx_replace
ADMIN_KEY=change_this_to_a_strong_secret
SYSTEM_SELLER_EMAIL=system@zenxstore.local
PORT=5000

# Optional S3 (for production image storage)
# S3_BUCKET=your-bucket
# S3_KEY=your-access-key
# S3_SECRET=your-secret
# S3_REGION=your-region
